
import random
import networkx as nx
import matplotlib.pyplot as plt
from matplotlib.animation import FuncAnimation
from IPython.display import HTML, display

random.seed(7)

G = nx.Graph()

pos = {
    "A": (0, 2), "B": (1.5, 3.5), "C": (1.5, 0.5),
    "D": (3, 2), "E": (4.5, 3.5), "F": (4.5, 0.5),
    "G": (6, 2)
}

edges = [
    ("A", "B", 2), ("A", "C", 4), ("B", "D", 2),
    ("C", "D", 1), ("B", "E", 3), ("D", "E", 2),
    ("D", "F", 3), ("C", "F", 2), ("E", "G", 2),
    ("F", "G", 3)
]

G.add_weighted_edges_from(edges)

nodes = list(G.nodes())
start = "A"

alpha = 1.0
beta = 2.0
evaporation = 0.4
Q = 1.0
num_ants = 30
iterations = 60

def edge_key(u, v):
    return frozenset((u, v))

def distance(u, v):
    return G[u][v]["weight"]

def tour_cost(tour):
    return sum(
        distance(tour[i], tour[i + 1])
        for i in range(len(tour) - 1)
    ) + distance(tour[-1], tour[0])

def can_complete(path):
    current = path[-1]
    visited = set(path)

    if len(path) == len(nodes):
        return G.has_edge(current, start)

    for nxt in G.neighbors(current):
        if nxt not in visited:
            if can_complete(path + [nxt]):
                return True

    return False

def get_choices(current, path, tau):
    candidates = []

    for nxt in G.neighbors(current):
        if nxt not in path and can_complete(path + [nxt]):
            candidates.append(nxt)

    if not candidates:
        return [], [], []

    weights = []

    for nxt in candidates:
        t = tau[edge_key(current, nxt)]
        d = distance(current, nxt)
        eta = 1.0 / d
        weights.append((t ** alpha) * (eta ** beta))

    total = sum(weights)
    probabilities = [w / total for w in weights]

    return candidates, weights, probabilities

tau = {
    edge_key(u, v): 1.0
    for u, v in G.edges()
}

best_tour = None
best_cost = float("inf")
history = []

for iteration in range(iterations):
    completed_tours = []

    for ant in range(num_ants):
        path = [start]

        while len(path) < len(nodes):
            candidates, weights, probabilities = get_choices(
                path[-1], path, tau
            )

            if not candidates:
                break

            nxt = random.choices(
                candidates, weights=probabilities, k=1
            )[0]

            path.append(nxt)

        if len(path) != len(nodes):
            continue

        if not G.has_edge(path[-1], start):
            continue

        cost = tour_cost(path)
        completed_tours.append((path[:], cost))

        if cost < best_cost:
            best_cost = cost
            best_tour = path[:]

    for edge in tau:
        tau[edge] *= (1.0 - evaporation)

    for path, cost in completed_tours:
        deposit = Q / cost

        for u, v in zip(path, path[1:]):
            tau[edge_key(u, v)] += deposit

        tau[edge_key(path[-1], path[0])] += deposit

    history.append(best_cost)

if best_tour is None:
    raise RuntimeError("No valid Hamiltonian tour was found.")

print("ACO TRAVELLING SALESMAN PROBLEM")
print("Best Tour:", " -> ".join(best_tour + [start]))
print("Minimum Tour Cost:", best_cost)
print("Vertices Visited:", len(best_tour))
print("Return to Start:", best_tour[-1] + " -> " + start)

demo_tau = tau.copy()
demo_path = [start]
steps = []

while len(demo_path) < len(nodes):
    current = demo_path[-1]

    candidates, weights, probabilities = get_choices(
        current, demo_path, demo_tau
    )

    chosen = random.choices(
        candidates, weights=probabilities, k=1
    )[0]

    steps.append({
        "current": current,
        "path": demo_path[:],
        "candidates": candidates[:],
        "weights": weights[:],
        "probabilities": probabilities[:],
        "chosen": chosen,
        "tau": demo_tau.copy()
    })

    demo_path.append(chosen)

steps.append({
    "current": demo_path[-1],
    "path": demo_path[:],
    "candidates": [start],
    "weights": [demo_tau[edge_key(demo_path[-1], start)]],
    "probabilities": [1.0],
    "chosen": start,
    "tau": demo_tau.copy()
})

fig = plt.figure(figsize=(16, 9))
gs = fig.add_gridspec(
    2, 2, height_ratios=[3, 1.2],
    width_ratios=[1.05, 1]
)

ax_net = fig.add_subplot(gs[0, 0])
ax_info = fig.add_subplot(gs[0, 1])
ax_graph = fig.add_subplot(gs[1, :])

edge_labels = nx.get_edge_attributes(G, "weight")

def update(frame):
    ax_net.clear()
    ax_info.clear()
    ax_graph.clear()

    data = steps[frame]
    current = data["current"]
    path = data["path"]
    candidates = data["candidates"]
    weights = data["weights"]
    probabilities = data["probabilities"]
    chosen = data["chosen"]
    frame_tau = data["tau"]

    if frame < len(nodes) - 1:
        title = f"AI Ant at Vertex {current}: Choosing Next Vertex"
    else:
        title = f"Returning to Start: {current} -> {start}"

    nx.draw_networkx_edges(
        G, pos, ax=ax_net, edge_color="lightgray", width=2
    )
    nx.draw_networkx_edge_labels(
        G, pos, edge_labels=edge_labels, ax=ax_net
    )

    visited = set(path)
    colors = []

    for node in nodes:
        if node == current:
            colors.append("orange")
        elif node == start:
            colors.append("limegreen")
        elif node == chosen:
            colors.append("violet")
        elif node in visited:
            colors.append("lightgreen")
        else:
            colors.append("skyblue")

    nx.draw_networkx_nodes(
        G, pos, ax=ax_net, node_color=colors,
        node_size=1100, edgecolors="white", linewidths=2
    )
    nx.draw_networkx_labels(
        G, pos, ax=ax_net, font_size=12, font_weight="bold"
    )

    traversed = list(zip(path[:-1], path[1:]))

    if traversed:
        nx.draw_networkx_edges(
            G, pos, edgelist=traversed,
            edge_color="green", width=4, ax=ax_net
        )

    if frame == len(nodes) - 1:
        nx.draw_networkx_edges(
            G, pos, edgelist=[(current, start)],
            edge_color="red", width=4, ax=ax_net
        )

    x, y = pos[current]
    ax_net.scatter(
        [x], [y], s=1800, facecolors="none",
        edgecolors="orange", linewidths=3, zorder=5
    )

    ax_net.set_title(title, fontsize=14, fontweight="bold")
    ax_net.axis("off")

    ax_info.axis("off")
    ax_info.set_title(
        "ACO Next-Vertex Decision",
        fontsize=14, fontweight="bold"
    )

    current_cost = sum(
        distance(u, v) for u, v in zip(path, path[1:])
    )

    lines = [
        f"Current vertex: {current}",
        f"Start vertex: {start}",
        f"Path so far: {' -> '.join(path)}",
        f"Cost so far: {current_cost}",
        "",
        "PROBABILITY FORMULA",
        "P = tau^alpha * eta^beta / sum(weights)",
        "eta = 1 / distance",
        "",
        "AVAILABLE NEXT VERTICES",
        "Node  Tau       Dist   Eta      Weight   Probability"
    ]

    for nxt, weight, probability in zip(
        candidates, weights, probabilities
    ):
        t = frame_tau[edge_key(current, nxt)]
        d = distance(current, nxt)
        eta = 1.0 / d
        marker = " <-- CHOSEN" if nxt == chosen else ""

        lines.append(
            f"{nxt:<5} {t:<9.4f} {d:<6} "
            f"{eta:<8.3f} {weight:<8.4f} "
            f"{probability:>6.1%}{marker}"
        )

    lines.extend([
        "",
        f"Alpha = {alpha} | Beta = {beta}",
        "",
        "Orange = Current vertex",
        "Violet = Chosen next vertex",
        "Green = Visited vertices",
        "Red = Return to starting vertex",
        "",
        "Every vertex is visited once.",
        "The final edge returns to A."
    ])

    ax_info.text(
        0.02, 0.96, "\n".join(lines),
        va="top", family="monospace", fontsize=9,
        transform=ax_info.transAxes,
        bbox=dict(
            boxstyle="round,pad=0.7",
            facecolor="#f0f7ff", edgecolor="steelblue"
        )
    )

    ax_graph.plot(
        range(1, len(history) + 1), history,
        color="blue", marker="o", markersize=3
    )
    ax_graph.set_title("ACO Convergence: Best Complete Tour Cost")
    ax_graph.set_xlabel("Iteration")
    ax_graph.set_ylabel("Tour Cost")
    ax_graph.grid(True, alpha=0.3)

    ax_graph.text(
        0.99, 0.95,
        f"Best tour: {' -> '.join(best_tour + [start])}"
        f" | Cost: {best_cost}",
        ha="right", va="top", transform=ax_graph.transAxes,
        bbox=dict(
            boxstyle="round", facecolor="#dcfce7",
            edgecolor="green"
        )
    )

    fig.tight_layout()

ani = FuncAnimation(
    fig, update,
    frames=len(steps),
    interval=2200,
    repeat=True
)

plt.close(fig)
display(HTML(ani.to_jshtml()))

print("\nFinal Complete Tour:")
print(" -> ".join(best_tour + [start]))
print("Total Distance:", best_cost)
